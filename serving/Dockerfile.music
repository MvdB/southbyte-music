# SGLang-Omni fuer MiniMax-Music3.
#
# Gebaut fuer den DGX Spark (GB10, sm_120, aarch64), aber nicht daran gebunden:
# das Basisimage gibt es fuer linux/arm64 und linux/amd64, und dieses Dockerfile
# ist arch-neutral. Der amd64-Zweig ist ungetestet — hier steht keine x86-GPU.
#
# Der Build braucht KEINE GPU. Es werden nur Pakete installiert; CUDA wird erst
# zur Laufzeit angefasst. Deshalb kann ein gewoehnlicher CI-Runner das Image
# bauen, und die Pruefung auf echter Hardware ist ein eigener Schritt
# (serving/pruefe_image.sh).
#
# Basis ist v0.5.16, weil sglang-omni v0.1.3 exakt sglang==0.5.16 pinnt. Im
# :dev-Image steckt sglang 0.0.0.dev1, ein
# pip install wuerde es herunterstufen und die mitgebauten Kernel zerschiessen.
FROM lmsysorg/sglang:v0.5.16

# ── Warum aus git und nicht von PyPI ─────────────────────────────────────
# Das Release 0.1.1 kennt MiniMax-Music3 NICHT. Der Start scheitert mit
#   ValueError: Config for MiniMaxMusic3ForConditionalGeneration not found
#   in the pipeline config registry
# Die Registry dort fuehrt Qwen3-TTS, Voxtral-TTS, Whisper, Zonos2 und andere,
# aber kein MiniMax. Unterstuetzt wird es erst seit Commit 05e268a4
# "[Model] Support MiniMax Music 3 Model (#1521)" vom 2026-08-13 — nach dem
# letzten Tag. Deshalb main statt PyPI.
#
# Auf den Release-Commit festgenagelt statt auf 'main': ein Image, das bei
# jedem Bau etwas anderes enthaelt, ist kein Artefakt, sondern ein Zufall.
# v0.1.3 enthaelt MiniMax-Music3 und #1558, das Stereo fuer MP3, FLAC, Opus
# und AAC in nicht-streamenden Antworten erhaelt.
ARG SGLANG_OMNI_COMMIT=91d4359fa06d1b60834250624116318ffa448e18

# --no-deps ist hier kein Trick, sondern korrekt: das Basisimage bringt den
# kompletten gepinnten Stack schon mit (geprueft 2026-08-14) — flash-attn-4
# 4.0.0b19, flashinfer-python 0.6.14, addict 2.4.0, imageio 2.36.0,
# imageio-ffmpeg 0.5.1, numba 0.65.1, transformers 5.12.1, torch 2.11.0+cu130.
# Ohne --no-deps wuerde pip versuchen, nemo_text_processing (-> pynini, kein
# aarch64-Wheel) und flash-attn-4 aus Quellen zu bauen; letzteres ist laut
# southbyte-image ein >100-min-Compile ueber vier Architekturen.
RUN pip install --no-cache-dir --no-deps \
        "git+https://github.com/sgl-project/sglang-omni.git@${SGLANG_OMNI_COMMIT}"

# ── flashinfer-cubin entfernen ───────────────────────────────────────────
# Ausdrueckliche Warnung im Kochbuch von sglang-omni (docs/cookbook/
# minimax_music3.md): "Do NOT add flashinfer-cubin: PyPI has no 0.6.14 cubin,
# and any leftover cubin wheel fails MiniMax DIT import." Das Basisimage
# bringt genau so ein Rest-Wheel mit (flashinfer-cubin 0.6.14), also raus damit
# — sonst scheitert der DIT-Import erst beim Modellstart.
RUN pip uninstall -y flashinfer-cubin || true

# ── Importwache ──────────────────────────────────────────────────────────
# Bricht den Build ab, wenn Torch seine CUDA-Bindung verloren hat, sglang_omni
# fehlt oder die MiniMax-Architektur nicht in der Registry steht. Ohne diese
# Pruefung faellt all das erst beim Modellstart auf.
# Registry ueber Introspektion pruefen statt ueber einen geratenen Klassennamen:
# ein erster Versuch importierte PipelineConfigRegistry, das es nicht gibt, und
# liess den Build an der Wache scheitern statt am eigentlichen Problem.
COPY pruefe_registry.py /tmp/pruefe_registry.py
RUN python3 /tmp/pruefe_registry.py \
 && command -v sgl-omni >/dev/null || { echo 'FEHLER: sgl-omni nicht im PATH'; exit 1; }

# ── Nicht als root ───────────────────────────────────────────────────────
# Das Basisimage laeuft als root mit HOME=/root. In Kubernetes ist
# runAsNonRoot eine uebliche Mindestforderung (Pod Security Standard
# "restricted"), und ohne passendes HOME landen Torch- und Triton-Caches in
# einem Verzeichnis, das der Nutzer nicht schreiben darf — der Start bricht
# dann an einer Stelle ab, die nichts mit der Ursache zu tun hat.
# Feste UID 1000, damit das Chart per fsGroup dieselbe Nummer setzen kann.
# Angelegt wird hier keiner: das Ubuntu-Basisimage belegt 1000 bereits mit dem
# Nutzer 'ubuntu', ein useradd --uid 1000 scheitert daran. Auf 1001 auszuweichen
# waere die bequeme Antwort und die schlechtere — 1000 ist die uebliche Nummer
# fuer den ersten Nicht-root-Nutzer, und jedes Beispiel im Netz setzt sie im
# Chart voraus. Also wird der vorhandene Nutzer umbenannt und mitsamt seinem
# Heimatverzeichnis verschoben (-m), statt eine zweite Nummer einzufuehren.
RUN usermod --login southbyte --home /home/southbyte --move-home ubuntu \
 && groupmod --new-name southbyte ubuntu \
 && id southbyte
ENV HOME=/home/southbyte \
    HF_HOME=/home/southbyte/.cache/huggingface \
    TRITON_CACHE_DIR=/home/southbyte/.cache/triton \
    TORCHINDUCTOR_CACHE_DIR=/home/southbyte/.cache/torchinductor \
    MODEL_PATH=/modelle/MiniMaxAI--MiniMax-Music3 \
    SERVE_HOST=0.0.0.0 \
    SERVE_PORT=8000 \
    PYTHONUNBUFFERED=1

COPY --chmod=0755 entrypoint.sh /usr/local/bin/entrypoint.sh
COPY --chmod=0755 hole_modell.sh /usr/local/bin/hole_modell.sh

# /modelle wird zur Laufzeit ueberdeckt (PVC, hostPath oder -v). Das Anlegen
# hier sorgt nur dafuer, dass der Pfad auch ohne Einbindung existiert und dem
# Dienstnutzer gehoert.
RUN mkdir -p /modelle && chown southbyte:southbyte /modelle

USER 1000:1000
WORKDIR /home/southbyte
EXPOSE 8000

# Fuer den reinen Docker-Betrieb. Kubernetes ignoriert HEALTHCHECK und nutzt
# stattdessen die Probes aus dem Deployment — die start-period hier entspricht
# der startupProbe dort: der Server braucht rund 160 s, bis er antwortet.
HEALTHCHECK --interval=30s --timeout=5s --start-period=300s --retries=3 \
  CMD curl -fsS "http://127.0.0.1:${SERVE_PORT}/health" || exit 1

ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]

# ── Herkunftsangaben ─────────────────────────────────────────────────────
# Ganz zum Schluss, weil jede Aenderung an ihnen sonst alle darueber liegenden
# Schichten ungueltig machen wuerde. Die Werte kommen aus der CI.
ARG VERSION=dev
ARG REVISION=unknown
ARG CREATED=unknown
LABEL org.opencontainers.image.title="southbyte-music" \
      org.opencontainers.image.description="MiniMax-Music3 als OpenAI-kompatibler Dienst ueber SGLang-Omni" \
      org.opencontainers.image.source="https://github.com/MvdB/southbyte-music" \
      org.opencontainers.image.licenses="MIT" \
      org.opencontainers.image.vendor="southbyte" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.revision="${REVISION}" \
      org.opencontainers.image.created="${CREATED}" \
      de.southbyte.model="MiniMaxAI/MiniMax-Music3" \
      de.southbyte.model-license="MiniMax-Music3 Community License" \
      de.southbyte.sglang-omni-commit="${SGLANG_OMNI_COMMIT}"
